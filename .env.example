# Copier ce fichier en .env et remplir les valeurs. Ne jamais commiter .env.

# --- Modele (palier gratuit d'une API ou Ollama) ---------------------------
# MODEL_PROVIDER : ollama | openai_compatible
#   ollama            -> modele local, ex. MODEL_NAME=qwen2.5:7b (ollama pull qwen2.5:7b)
#   openai_compatible -> toute API compatible OpenAI (Groq, OpenRouter, Gemini...)
#                        ex. MODEL_BASE_URL=https://api.groq.com/openai/v1
#                            MODEL_NAME=llama-3.3-70b-versatile
MODEL_PROVIDER=ollama
MODEL_NAME=qwen2.5:7b
MODEL_BASE_URL=
MODEL_API_KEY=changeme
MODEL_TEMPERATURE=0

# --- Boucle de l'agent -------------------------------------------------------
AGENT_MAX_ETAPES=8
AGENT_MAX_APPELS_OUTILS=12
AGENT_RETRIES_OUTILS=2
TRACES_DIR=traces

# --- Serveur MCP catalogue ----------------------------------------------------
CATALOGUE_DB_PATH=data/catalogue.db
# "stdio" : l'agent lance lui-meme le serveur ; sinon l'URL du serveur HTTP
MCP_SERVER_URL=stdio
# MCP_SERVER_URL=http://127.0.0.1:8000/mcp

# --- Google (compte de test de l'atelier uniquement) ---------------------------
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
AGENCY_EMAIL=agence.test@example.com
CALENDAR_ID_CONSEILLER_1=changeme@group.calendar.google.com
CALENDAR_ID_CONSEILLER_2=changeme@group.calendar.google.com
CALENDAR_ID_CONSEILLER_3=changeme@group.calendar.google.com
TIMEZONE=Africa/Dakar
